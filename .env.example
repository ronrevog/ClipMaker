# ==============================================================================
# ClipMaker Studio — Shared Vercel Environment Variables
# Set these in Vercel Dashboard -> Settings -> Environment Variables (or in .env)
# Everyone signed in with a @complex.com email will automatically use these keys!
# ==============================================================================

# 1. Shared AI Provider API Keys (Used by all @complex.com users)
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_claude_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# 2. Optional @complex.com Authentication Settings
# Leave COMPLEX_ACCESS_CODE blank to allow any @complex.com email without a passcode
COMPLEX_ACCESS_CODE=
COMPLEX_AUTH_SECRET=clipmaker-complex-studio-secret

# 3. Optional Vercel Blob Storage Token (Auto-injected when enabling Vercel Blob in Vercel Dashboard)
# Enables cross-device cloud persistence for saved projects and videos
BLOB_READ_WRITE_TOKEN=

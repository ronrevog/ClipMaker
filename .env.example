# ==============================================================================
# ClipMaker Studio — Shared Vercel Environment Variables
# Set these in Vercel Dashboard -> Settings -> Environment Variables (or in .env)
# ==============================================================================

# 1. Google Workspace OAuth Client ID (Restricts Google Sign-In strictly to @complex.com)
# Create in Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs (Web Application)
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# 2. Shared AI Provider API Keys (Automatically used by all authenticated @complex.com users)
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_claude_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# 3. Session Signing Secret
COMPLEX_AUTH_SECRET=clipmaker-complex-studio-secret

# 4. Optional Vercel Blob Storage Token (Auto-injected when enabling Vercel Blob in Vercel Dashboard)
BLOB_READ_WRITE_TOKEN=
